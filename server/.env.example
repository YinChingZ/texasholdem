# Server Configuration
PORT=3000
NODE_ENV=development

# CORS Settings (for production, set to your frontend domain)
CORS_ORIGIN=http://localhost:5173

# Server-owned game deadlines (milliseconds)
TURN_TIMEOUT_MS=45000
NEXT_HAND_MS=8000
PACING_MS=600
HOST_GRACE_MS=30000
SESSION_PROBE_MS=3000
ROOM_IDLE_MS=1800000

# Agent 托管默认关闭；SIGHUP 可在线撤销全部授权并关闭。
AGENT_ENABLED=false
